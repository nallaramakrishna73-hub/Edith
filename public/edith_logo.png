<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <!-- Background Radial Glow -->
    <radialGradient id="bgGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#00E5FF" stop-opacity="0.15" />
      <stop offset="60%" stop-color="#0A1128" stop-opacity="0.05" />
      <stop offset="100%" stop-color="#05080F" stop-opacity="0" />
    </radialGradient>

    <!-- Neon Glow Filter -->
    <filter id="cyanGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <filter id="intenseGlow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="10" result="blur1" />
      <feGaussianBlur stdDeviation="4" result="blur2" />
      <feMerge>
        <feMergeNode in="blur1" />
        <feMergeNode in="blur2" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <!-- Gradients for Arcs -->
    <linearGradient id="arcCyanBlue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00E5FF" />
      <stop offset="100%" stop-color="#2F6BFF" />
    </linearGradient>

    <linearGradient id="arcBlue" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#2F6BFF" />
      <stop offset="100%" stop-color="#00E5FF" />
    </linearGradient>
  </defs>

  <!-- Background tile -->
  <rect width="512" height="512" rx="32" fill="#05080F" />
  <circle cx="256" cy="256" r="220" fill="url(#bgGlow)" />

  <!-- 4 Cardinal Crosshairs -->
  <line x1="256" y1="64" x2="256" y2="82" stroke="#00E5FF" stroke-width="4" stroke-linecap="round" filter="url(#cyanGlow)" />
  <line x1="256" y1="430" x2="256" y2="448" stroke="#00E5FF" stroke-width="4" stroke-linecap="round" filter="url(#cyanGlow)" />
  <line x1="64" y1="256" x2="82" y2="256" stroke="#00E5FF" stroke-width="4" stroke-linecap="round" filter="url(#cyanGlow)" />
  <line x1="430" y1="256" x2="448" y2="256" stroke="#00E5FF" stroke-width="4" stroke-linecap="round" filter="url(#cyanGlow)" />

  <!-- Outer Dial Ticks (36 ticks at 10 deg intervals) -->
  <g stroke="#00E5FF" stroke-opacity="0.4" stroke-width="2">
    <!-- Generated angles for HUD dial -->
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(10 256 256)" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(20 256 256)" />
    <line x1="256" y1="88" x2="256" y2="98" transform="rotate(30 256 256)" stroke-opacity="0.8" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(40 256 256)" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(50 256 256)" />
    <line x1="256" y1="88" x2="256" y2="98" transform="rotate(60 256 256)" stroke-opacity="0.8" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(70 256 256)" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(80 256 256)" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(100 256 256)" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(110 256 256)" />
    <line x1="256" y1="88" x2="256" y2="98" transform="rotate(120 256 256)" stroke-opacity="0.8" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(130 256 256)" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(140 256 256)" />
    <line x1="256" y1="88" x2="256" y2="98" transform="rotate(150 256 256)" stroke-opacity="0.8" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(160 256 256)" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(170 256 256)" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(190 256 256)" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(200 256 256)" />
    <line x1="256" y1="88" x2="256" y2="98" transform="rotate(210 256 256)" stroke-opacity="0.8" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(220 256 256)" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(230 256 256)" />
    <line x1="256" y1="88" x2="256" y2="98" transform="rotate(240 256 256)" stroke-opacity="0.8" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(250 256 256)" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(260 256 256)" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(280 256 256)" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(290 256 256)" />
    <line x1="256" y1="88" x2="256" y2="98" transform="rotate(300 256 256)" stroke-opacity="0.8" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(310 256 256)" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(320 256 256)" />
    <line x1="256" y1="88" x2="256" y2="98" transform="rotate(330 256 256)" stroke-opacity="0.8" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(340 256 256)" />
    <line x1="256" y1="88" x2="256" y2="96" transform="rotate(350 256 256)" />
  </g>

  <!-- Outer Precision Ring -->
  <circle cx="256" cy="256" r="162" fill="none" stroke="#00E5FF" stroke-width="4" filter="url(#cyanGlow)" />

  <!-- Dotted Orbit Ring -->
  <circle cx="256" cy="256" r="146" fill="none" stroke="#2F6BFF" stroke-width="3" stroke-dasharray="4 8" stroke-opacity="0.8" />

  <!-- Orbit Nodes -->
  <circle cx="359" cy="153" r="5" fill="#00E5FF" filter="url(#cyanGlow)" />
  <circle cx="153" cy="359" r="5" fill="#2F6BFF" filter="url(#cyanGlow)" />
  <circle cx="380" cy="256" r="3.5" fill="#00E5FF" />
  <circle cx="132" cy="256" r="3.5" fill="#2F6BFF" />

  <!-- Tactical Arcs -->
  <!-- Arc 1: Blue arc left (from ~140 to 220 deg) -->
  <path d="M 148 318 A 125 125 0 0 1 148 194" fill="none" stroke="#2F6BFF" stroke-width="8" stroke-linecap="round" filter="url(#cyanGlow)" />
  <!-- Node on blue arc -->
  <circle cx="124" cy="310" r="7" fill="#2F6BFF" filter="url(#cyanGlow)" />
  <circle cx="124" cy="310" r="3" fill="#05080F" />

  <!-- Arc 2: Cyan arc top right (from -40 to 45 deg) -->
  <path d="M 238 132 A 125 125 0 0 1 368 220" fill="none" stroke="#00E5FF" stroke-width="8" stroke-linecap="round" filter="url(#intenseGlow)" />
  <!-- Node on top right arc -->
  <circle cx="368" cy="168" r="9" fill="#00E5FF" filter="url(#intenseGlow)" />
  <circle cx="368" cy="168" r="4" fill="#05080F" />

  <!-- Arc 3: Cyan arc bottom right (from 60 to 120 deg) -->
  <path d="M 370 292 A 125 125 0 0 1 230 376" fill="none" stroke="#00E5FF" stroke-width="6" stroke-linecap="round" filter="url(#cyanGlow)" />
  <circle cx="352" cy="360" r="7" fill="#00E5FF" filter="url(#cyanGlow)" />
  <circle cx="352" cy="360" r="3" fill="#05080F" />

  <!-- Inner Dark Core with Rings -->
  <circle cx="256" cy="256" r="92" fill="#0A1128" stroke="#00E5FF" stroke-width="3" stroke-opacity="0.6" />
  <circle cx="256" cy="256" r="78" fill="#060C1B" stroke="#00E5FF" stroke-width="1.5" stroke-opacity="0.3" />
  <circle cx="256" cy="256" r="64" fill="#05080F" stroke="#2F6BFF" stroke-width="1" stroke-dasharray="2 4" stroke-opacity="0.5" />

  <!-- Center Geometric 'E' -->
  <!-- Glowing back-layers for neon depth -->
  <g transform="translate(256 256)" filter="url(#intenseGlow)">
    <!-- Neon back glow of E -->
    <path d="M 24 -40 L -20 -40 C -26 -40 -30 -36 -30 -30 L -30 30 C -30 36 -26 40 -20 40 L 24 40 C 27 40 29 37 29 34 L 29 26 C 29 23 27 21 24 21 L -10 21 L -10 9 L 18 9 C 21 9 23 7 23 4 L 23 -4 C 23 -7 21 -9 18 -9 L -10 -9 L -10 -21 L 24 -21 C 27 -21 29 -23 29 -26 L 29 -34 C 29 -37 27 -40 24 -40 Z" fill="#00E5FF" opacity="0.6" />
  </g>

  <g transform="translate(256 256)" filter="url(#cyanGlow)">
    <!-- Primary sharp geometric neon E -->
    <path d="M 24 -40 L -20 -40 C -26 -40 -30 -36 -30 -30 L -30 30 C -30 36 -26 40 -20 40 L 24 40 C 27 40 29 37 29 34 L 29 26 C 29 23 27 21 24 21 L -10 21 L -10 9 L 18 9 C 21 9 23 7 23 4 L 23 -4 C 23 -7 21 -9 18 -9 L -10 -9 L -10 -21 L 24 -21 C 27 -21 29 -23 29 -26 L 29 -34 C 29 -37 27 -40 24 -40 Z" fill="#A5F3FC" />
  </g>
</svg>
